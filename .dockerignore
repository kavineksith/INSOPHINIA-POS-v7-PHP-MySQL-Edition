# Files to exclude from the Docker build context (speeds up builds, smaller image)
# ----------------------------------------------------------------------------
.git/
.gitignore
.github/
.vscode/
.idea/
*.md
!README.md

# Local config (will be generated by entrypoint from env vars)
config/config.php

# Composer vendor (installed inside the image)
vendor/

# Storage runtime data (use Docker volumes instead)
storage/temp_pdfs/*
storage/logs/*
storage/cache/*
!storage/temp_pdfs/.gitkeep
!storage/logs/.gitkeep
!storage/cache/.gitkeep

# Build/test artifacts
*.zip
*.tar.gz
node_modules/
tests/
__tests__/
.phpunit*

# OS files
.DS_Store
Thumbs.db

# Docker files themselves (not needed inside the image)
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
.env
.env.*
!.env.example

# IDE
*.swp
*.swo
*~
