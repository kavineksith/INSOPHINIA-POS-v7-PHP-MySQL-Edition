{
    "name": "insophinia/pos-v7-php",
    "description": "INSOPHINIA POS v7 — Pure PHP + MySQL port of the Next.js original. Bootstrap 5, jQuery, mPDF, PHPMailer, JWT auth, full RBAC, audit logging.",
    "type": "project",
    "license": "Proprietary",
    "version": "7.0.0",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "mpdf/mpdf": "^8.2",
        "ramsey/uuid": "^4.7",
        "vlucas/valitron": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Insophinia\\POS\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('config/config.php') || copy('config/config.example.php', 'config/config.php');\"",
            "echo 'INSOPHINIA POS v7 installed. Next: edit config/config.php and run: php seed.php'"
        ],
        "seed": "@php seed.php",
        "serve": "@php -S localhost:8080 -t public public/index.php"
    }
}
