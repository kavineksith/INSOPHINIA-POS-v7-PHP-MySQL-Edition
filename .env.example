# ============================================================================
# INSOPHINIA POS v7 — Docker environment variables
# ----------------------------------------------------------------------------
# Copy to .env and edit before running:
#   cp .env.example .env
#   docker compose up -d --build
# ============================================================================

# ---- App (POS UI) ----
APP_PORT=8080
APP_URL=http://localhost:8080
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo

# Set to "true" once you've enabled HTTPS via a reverse proxy
COOKIE_SECURE=false

# ---- Database (must match mysql service) ----
DB_NAME=insophinia_pos
DB_USER=insophinia
DB_PASS=change-this-to-a-strong-password
MYSQL_ROOT_PASSWORD=root-password-change-me-too
MYSQL_PORT=3306

# ---- JWT secret — CRITICAL: generate a new one for production ----
# Run: docker run --rm php:8.2-cli php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Paste the output below:
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS_LONG_xxxxxxxxxxxxx

# ---- phpMyAdmin ----
PMA_PORT=8081

# ---- Seed admin credentials (used on first run only) ----
SEED_ADMIN_USERNAME=master
SEED_ADMIN_PASSWORD=Master@Admin123!
SEED_ADMIN_EMAIL=master@insophinia.lk

# ---- Email (SMTP) — leave disabled to start ----
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SECURE=tls
EMAIL_FROM=INSOPHINIA <noreply@insophinia.lk>
